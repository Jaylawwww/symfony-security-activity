{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}
<div class="example-wrapper" style="margin:1em auto; max-width:800px; width:95%; font:18px/1.5 sans-serif;">
    <h1>Dashboard</h1>

    {% if is_granted('ROLE_ADMIN') %}
        <p><strong>Admin:</strong> You are logged in as Admin. You have full access.</p>
    {% else %}
        <p><strong>User:</strong> You are logged in as Regular User. Limited access granted.</p>
    {% endif %}

    <p>
        Logged in as: {{ app.user ? app.user.userIdentifier : 'Guest' }}
    </p>
</div>
{% endblock %}
